{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "IcapJuvenilDb",
    "UsersCollectionName": "Users",
    "ReceiptsCollectionName": "Receipts",
    "CountersCollectionName": "Counters"
  },
  "JwtSettings": {
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_IN_USER_SECRETS_OR_ENV_VARS",
    "Issuer": "IcapJuvenil.Api",
    "Audience": "IcapJuvenil.Client",
    "ExpirationMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Seed": {
    "EnableInitialSeed": false
  }
}
